<mxfile host="app.diagrams.net" type="device" agent="generado para el laboratorio MLFQ" compressed="false"><diagram id="pagina-1" name="1. Arquitectura y regla de dependencia"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="Arquitectura limpia: cuatro capas y una sola regla" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=17;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="25" width="900" height="30" as="geometry"/></mxCell><mxCell id="t2" value="Las dependencias apuntan SIEMPRE hacia el dominio. Ninguna capa interna conoce a una externa." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="51" width="900" height="24" as="geometry"/></mxCell><mxCell id="b3" value="cli  ·  detalles de la consola" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;dashed=0;opacity=60;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="900" height="100" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b style=&quot;&quot;&gt;src/cli/main.c&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;COMPOSITION ROOT: unico archivo que crea&lt;br/&gt;implementaciones concretas y las inyecta&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="120" width="420" height="58" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b style=&quot;&quot;&gt;src/cli/cli_options.c&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;traduce argv a configuracion validada&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="520" y="120" width="420" height="58" as="geometry"/></mxCell><mxCell id="b6" value="infrastructure  ·  adaptadores (hablan con el mundo exterior)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;dashed=0;opacity=60;" vertex="1" parent="1"><mxGeometry x="60" y="220" width="900" height="150" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b style=&quot;&quot;&gt;Entrada&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;csv_process_source.c&lt;br/&gt;random_process_source.c&lt;br/&gt;builtin_scenario_process_source.c&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="253" width="275" height="105" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b style=&quot;&quot;&gt;Salida&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;csv_results_writer.c&lt;br/&gt;console_results_writer.c&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="370" y="253" width="275" height="105" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b style=&quot;&quot;&gt;Observadores&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;trace_observer.c   gantt_observer.c&lt;br/&gt;stats_observer.c   wait_gap_observer.c&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="660" y="253" width="280" height="105" as="geometry"/></mxCell><mxCell id="b10" value="application  ·  casos de uso y puertos" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;dashed=0;opacity=60;" vertex="1" parent="1"><mxGeometry x="60" y="400" width="900" height="150" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b style=&quot;&quot;&gt;run_simulation_use_case.c&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;orquesta: cargar -&gt; simular -&gt; medir -&gt; publicar&lt;br/&gt;no conoce ninguna tecnologia concreta&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="433" width="400" height="105" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b style=&quot;&quot;&gt;simulation_engine.c&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;reloj discreto&lt;br/&gt;ciclo de vida&lt;br/&gt;publica eventos&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="500" y="433" width="200" height="105" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b style=&quot;&quot;&gt;ports/&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;process_source.h&lt;br/&gt;results_writer.h&lt;br/&gt;(interfaces que la&lt;br/&gt;infraestructura implementa)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="433" width="220" height="105" as="geometry"/></mxCell><mxCell id="b14" value="domain  ·  entidades y reglas de negocio (nucleo)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;dashed=0;opacity=60;" vertex="1" parent="1"><mxGeometry x="60" y="580" width="900" height="235" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b style=&quot;&quot;&gt;process.h / .c&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;entidad Process (tipo OPACO)&lt;br/&gt;process_internal.h -&gt; privado del paquete&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="613" width="270" height="92" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b style=&quot;&quot;&gt;process_state.h / .c&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;patron STATE&lt;br/&gt;NEW READY RUNNING WAITING TERMINATED&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="365" y="613" width="270" height="92" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b style=&quot;&quot;&gt;scheduling_policy.h&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;patron STRATEGY&lt;br/&gt;contrato de planificacion&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="650" y="613" width="290" height="92" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b style=&quot;&quot;&gt;ready_queue.h&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;ABSTRACCION de cola + 2 impl.&lt;br/&gt;fifo / shortest_remaining&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="720" width="270" height="82" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b style=&quot;&quot;&gt;event_bus.h  ·  metrics.h&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;patron OBSERVER (sujeto)&lt;br/&gt;calculo de metricas&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="365" y="720" width="270" height="82" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b style=&quot;&quot;&gt;policies/&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;mlfq_policy.c (MLFQ configurable)&lt;br/&gt;simple_policies.c (FCFS y Round Robin)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="650" y="720" width="290" height="82" as="geometry"/></mxCell><mxCell id="e21" value="depende de" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;endSize=10;dashed=1;html=1;strokeColor=#666666;exitX=0.35;exitY=1;entryX=0.35;entryY=0;" edge="1" parent="1" source="b3" target="b6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;endSize=10;dashed=1;html=1;strokeColor=#666666;exitX=0.75;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="b3" target="b6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e23" value="depende de" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;endSize=10;dashed=1;html=1;strokeColor=#666666;exitX=0.35;exitY=1;entryX=0.35;entryY=0;" edge="1" parent="1" source="b6" target="b10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;endSize=10;dashed=1;html=1;strokeColor=#666666;exitX=0.75;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="b6" target="b10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e25" value="depende de" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;endSize=10;dashed=1;html=1;strokeColor=#666666;exitX=0.35;exitY=1;entryX=0.35;entryY=0;" edge="1" parent="1" source="b10" target="b14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;endSize=10;dashed=1;html=1;strokeColor=#666666;exitX=0.75;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="b10" target="b14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;shape=singleArrow;direction=south;arrowWidth=0.5;arrowSize=0.08;" vertex="1" parent="1"><mxGeometry x="985" y="90" width="55" height="725" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b style=&quot;&quot;&gt;El dominio es independiente de la tecnologia&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;No aparece FILE, fopen ni printf en src/domain&lt;br/&gt;(solo snprintf, que formatea en memoria).&lt;br/&gt;&lt;br/&gt;El formato CSV existe en 2 archivos y los dos&lt;br/&gt;son de infraestructura: csv_process_source.c&lt;br/&gt;y csv_results_writer.c.&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1060" y="90" width="310" height="175" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b style=&quot;&quot;&gt;Regla de dependencia, verificable&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;$ grep -rn &#x27;#include &quot;infrastructure|&lt;br/&gt;   application|cli&#x27; src/domain src/policies&lt;br/&gt;&lt;br/&gt;  -&gt; sin resultados&lt;br/&gt;&lt;br/&gt;$ grep -rn &#x27;mlfq_policy_create&#x27; src/application/&lt;br/&gt;&lt;br/&gt;  -&gt; sin resultados&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1060" y="290" width="310" height="155" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b style=&quot;&quot;&gt;Leyenda&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;Colores = capa de la arquitectura limpia&lt;br/&gt;&amp;#9632; azul  dominio        &amp;#9632; verde  aplicacion&lt;br/&gt;&amp;#9632; naranja infraestructura  &amp;#9632; violeta cli&lt;br/&gt;&amp;#9632; amarillo nota/decision de disenio&lt;br/&gt;&lt;br/&gt;Flechas:  ----&amp;#9655; implementa la interfaz&lt;br/&gt;          ----&amp;gt;  depende de / usa&lt;br/&gt;          &amp;#9472;&amp;#9472;&amp;#9654;  flujo de control o de datos&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1060" y="470" width="310" height="132" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b style=&quot;&quot;&gt;Las 4 capas en una frase&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;cli             decide QUE implementaciones&lt;br/&gt;                se usan y las inyecta&lt;br/&gt;&lt;br/&gt;infrastructure  habla con archivos y consola&lt;br/&gt;&lt;br/&gt;application     ordena los pasos del caso&lt;br/&gt;                de uso y define los puertos&lt;br/&gt;&lt;br/&gt;domain          las reglas del scheduler;&lt;br/&gt;                no depende de nada&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1060" y="620" width="310" height="195" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pagina-2" name="2. Patron State"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="Patron STATE: ciclo de vida del proceso" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=17;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="1000" height="30" as="geometry"/></mxCell><mxCell id="t2" value="Cada estado es un objeto inmutable que define QUE transiciones son legales desde el. Process solo delega." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="56" width="1000" height="24" as="geometry"/></mxCell><mxCell id="c3" value="&lt;i style=&quot;font-size:9px;color:#666&quot;&gt;&amp;#171;entidad, tipo opaco&amp;#187;&lt;/i&gt;&lt;br/&gt;&lt;b style=&quot;&quot;&gt;Process&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:8px;color:#777;font-family:monospace&quot;&gt;include/domain/process.h  ·  src/domain/process.c&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;- pid, arrival_time, burst_time&lt;br/&gt;- remaining_time&lt;br/&gt;- start_time, finish_time&lt;br/&gt;- first_response_time&lt;br/&gt;- current_queue&lt;br/&gt;- state: const ProcessState*&lt;br/&gt;&lt;br/&gt;+ process_admit / dispatch / preempt&lt;br/&gt;+ process_block / resume / terminate&lt;br/&gt;+ process_consume_cycle&lt;br/&gt;&lt;br/&gt;El struct es OPACO: nadie fuera del&lt;br/&gt;paquete puede escribir sus campos.&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="105" width="280" height="215" as="geometry"/></mxCell><mxCell id="c4" value="&lt;i style=&quot;font-size:9px;color:#666&quot;&gt;&amp;#171;interface (vtable)&amp;#187;&lt;/i&gt;&lt;br/&gt;&lt;b style=&quot;&quot;&gt;ProcessState&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:8px;color:#777;font-family:monospace&quot;&gt;include/domain/process_state.h  ·  src/domain/process_state.c&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;+ id : ProcessStateId&lt;br/&gt;+ name : const char*&lt;br/&gt;&lt;br/&gt;punteros a funcion (una por transicion):&lt;br/&gt;  admit()        dispatch()&lt;br/&gt;  preempt()      block()&lt;br/&gt;  resume()       terminate()&lt;br/&gt;  consume_cycle()&lt;br/&gt;&lt;br/&gt;Cada estado concreto implementa las&lt;br/&gt;legales y rechaza el resto.&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="105" width="300" height="215" as="geometry"/></mxCell><mxCell id="e5" value="state (delega toda transicion)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=diamondThin;endFill=1;endSize=12;html=1;strokeColor=#666666;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c6" value="&lt;b style=&quot;font-family:monospace;&quot;&gt;NEW&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;admit &amp;#10003;&lt;br/&gt;resto: reject&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="400" width="124" height="105" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b style=&quot;font-family:monospace;&quot;&gt;READY&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;dispatch &amp;#10003;&lt;br/&gt;fija start_time y&lt;br/&gt;first_response_time&lt;br/&gt;solo la 1a vez&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="192" y="400" width="124" height="105" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b style=&quot;font-family:monospace;&quot;&gt;RUNNING&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;preempt &amp;#10003;&lt;br/&gt;block &amp;#10003;&lt;br/&gt;terminate &amp;#10003;&lt;br/&gt;consume_cycle &amp;#10003;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="324" y="400" width="124" height="105" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b style=&quot;font-family:monospace;&quot;&gt;WAITING&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;resume &amp;#10003;&lt;br/&gt;resto: reject&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="456" y="400" width="124" height="105" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b style=&quot;font-family:monospace;&quot;&gt;TERMINATED&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;todo: reject&lt;br/&gt;(estado final)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="588" y="400" width="124" height="105" as="geometry"/></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=0;endSize=12;dashed=1;html=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="c6" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=0;endSize=12;dashed=1;html=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="c7" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=0;endSize=12;dashed=1;html=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="c8" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=0;endSize=12;dashed=1;html=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="c9" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=0;endSize=12;dashed=1;html=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="c10" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="&lt;b style=&quot;&quot;&gt;Por que aporta valor y no es decoracion&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;1. RUNNING es el unico estado que sabe descontar rafaga (running_consume_cycle) y READY el unico&lt;br/&gt;   que fija start_time / first_response_time: el motor de simulacion NO tiene ningun if (primera vez).&lt;br/&gt;2. Una transicion ilegal (despachar un proceso TERMINATED) corromperia las metricas sin sintoma;&lt;br/&gt;   aqui se detiene con un mensaje unico generado por el helper reject() (process_state.c).&lt;br/&gt;3. Cada transicion ilegal tiene prueba unitaria: tests/test_process_state.c&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="545" width="640" height="130" as="geometry"/></mxCell><mxCell id="t17" value="Maquina de estados resultante" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="760" y="95" width="560" height="24" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b style=&quot;&quot;&gt;NEW&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;rounded=1;" vertex="1" parent="1"><mxGeometry x="1010" y="130" width="130" height="42" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b style=&quot;&quot;&gt;READY&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;rounded=1;" vertex="1" parent="1"><mxGeometry x="1010" y="235" width="130" height="42" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b style=&quot;&quot;&gt;RUNNING&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;rounded=1;" vertex="1" parent="1"><mxGeometry x="1010" y="350" width="130" height="42" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b style=&quot;&quot;&gt;WAITING&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;rounded=1;" vertex="1" parent="1"><mxGeometry x="1210" y="350" width="130" height="42" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b style=&quot;&quot;&gt;TERMINATED&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=center;verticalAlign=middle;rounded=1;" vertex="1" parent="1"><mxGeometry x="1010" y="480" width="130" height="42" as="geometry"/></mxCell><mxCell id="e23" value="process_admit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;html=1;strokeColor=#333333;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e24" value="process_dispatch" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;html=1;strokeColor=#333333;" edge="1" parent="1" source="c19" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e25" value="process_preempt" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;html=1;strokeColor=#333333;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c20" target="c19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="960" y="371"/><mxPoint x="960" y="256"/></Array></mxGeometry></mxCell><mxCell id="e26" value="process_block" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;html=1;strokeColor=#333333;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e27" value="process_resume" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;html=1;strokeColor=#333333;exitX=0.5;exitY=0;entryX=1;entryY=0.5;" edge="1" parent="1" source="c21" target="c19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1275" y="256"/></Array></mxGeometry></mxCell><mxCell id="e28" value="process_terminate
(fija finish_time)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;html=1;strokeColor=#333333;" edge="1" parent="1" source="c20" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="am29" value="process_consume_cycle
(remaining_time--)" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#ffffff;align=left;verticalAlign=middle;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="355" as="sourcePoint"/><mxPoint x="1140" y="385" as="targetPoint"/><Array as="points"><mxPoint x="1260" y="355"/><mxPoint x="1260" y="385"/></Array></mxGeometry></mxCell><mxCell id="c30" value="&lt;b style=&quot;&quot;&gt;Convencion temporal (decidida y documentada)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;El ciclo t representa el intervalo [t, t+1).&lt;br/&gt;  start_time          = ciclo del primer despacho&lt;br/&gt;  first_response_time = igual al primer despacho&lt;br/&gt;  finish_time         = t + 1 si su ultimo ciclo ejecutado fue t&lt;br/&gt;Sin fijarla, turnaround y waiting quedan desplazados en 1 ciclo.&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="760" y="560" width="560" height="115" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pagina-3" name="3. Patron Strategy"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="Patron STRATEGY: la politica de planificacion es una dependencia inyectada" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=17;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="1100" height="30" as="geometry"/></mxCell><mxCell id="t2" value="El motor es dueno del reloj; la politica es duena de las colas, del quantum, de la democion y del boost." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="56" width="1100" height="24" as="geometry"/></mxCell><mxCell id="c3" value="&lt;i style=&quot;font-size:9px;color:#666&quot;&gt;&amp;#171;capa de aplicacion&amp;#187;&lt;/i&gt;&lt;br/&gt;&lt;b style=&quot;&quot;&gt;SimulationEngine&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:8px;color:#777;font-family:monospace&quot;&gt;src/application/simulation_engine.c&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;+ simulation_engine_run(config, result, error)&lt;br/&gt;  - admit_arrivals()&lt;br/&gt;  - switch_context()&lt;br/&gt;&lt;br/&gt;Sabe: reloj discreto, transiciones de&lt;br/&gt;estado, ciclos ociosos, eventos.&lt;br/&gt;&lt;br/&gt;NO sabe: cuantas colas hay, que es un&lt;br/&gt;quantum, que es un priority boost.&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="105" width="320" height="175" as="geometry"/></mxCell><mxCell id="c4" value="&lt;i style=&quot;font-size:9px;color:#666&quot;&gt;&amp;#171;interface&amp;#187;&lt;/i&gt;&lt;br/&gt;&lt;b style=&quot;&quot;&gt;SchedulingPolicy&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:8px;color:#777;font-family:monospace&quot;&gt;include/domain/scheduling_policy.h&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;+ name&lt;br/&gt;+ admit(p, cycle)&lt;br/&gt;     un proceso pasa a estar listo&lt;br/&gt;+ select_for_cycle(cycle) : Process*&lt;br/&gt;     quien ocupa la CPU en este ciclo&lt;br/&gt;     (NULL = CPU ociosa)&lt;br/&gt;+ notify_cycle_result(p, completed, cycle)&lt;br/&gt;     resultado del ciclo ejecutado&lt;br/&gt;+ describe_queues()   [opcional, ISP]&lt;br/&gt;+ destroy()&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="105" width="350" height="205" as="geometry"/></mxCell><mxCell id="e5" value="depende de la ABSTRACCION (DIP)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;endSize=10;dashed=1;html=1;strokeColor=#666666;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c6" value="&lt;i style=&quot;font-size:9px;color:#666&quot;&gt;&amp;#171;configuracion inyectada&amp;#187;&lt;/i&gt;&lt;br/&gt;&lt;b style=&quot;&quot;&gt;MlfqConfig&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:8px;color:#777;font-family:monospace&quot;&gt;include/domain/policies/mlfq_policy.h&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;int  level_count            1..8&lt;br/&gt;int  quantums[]             p. ej. 2, 4, 8&lt;br/&gt;int  boost_interval         S (0 = sin boost)&lt;br/&gt;bool preempt_on_higher_priority&lt;br/&gt;MlfqDemotionRule demotion_rule&lt;br/&gt;ReadyQueueFactory queue_factory&lt;br/&gt;EventBus *event_bus&lt;br/&gt;&lt;br/&gt;Todo lo variable viaja en la config,&lt;br/&gt;no en constantes dentro del .c.&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="850" y="105" width="330" height="205" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b style=&quot;&quot;&gt;MlfqPolicy&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:8px;color:#777;font-family:monospace&quot;&gt;src/policies/mlfq_policy.c&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;- levels[] : ReadyQueue*        (abstraccion)&lt;br/&gt;- quantums[], boost_interval&lt;br/&gt;- demotion_rule                 (inyectada)&lt;br/&gt;- cpu_holder, consumed_quantum&lt;br/&gt;&lt;br/&gt;- expire_quantum()      democion&lt;br/&gt;- apply_priority_boost()&lt;br/&gt;- preempt_holder()&lt;br/&gt;- highest_ready_level()&lt;br/&gt;- enqueue_at_level()    unico punto que&lt;br/&gt;  mueve un proceso entre colas (DRY)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="390" width="350" height="195" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b style=&quot;&quot;&gt;RoundRobinPolicy&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:8px;color:#777;font-family:monospace&quot;&gt;src/policies/simple_policies.c&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;una cola FIFO&lt;br/&gt;quantum fijo&lt;br/&gt;sin niveles&lt;br/&gt;sin democion&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="850" y="390" width="160" height="115" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b style=&quot;&quot;&gt;FcfsPolicy&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:8px;color:#777;font-family:monospace&quot;&gt;simple_policies.c&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;una cola FIFO&lt;br/&gt;no expropiativo&lt;br/&gt;quantum = INT_MAX&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1030" y="390" width="150" height="115" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=0;endSize=12;dashed=1;html=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="c7" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=0;endSize=12;dashed=1;html=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="c8" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=0;endSize=12;dashed=1;html=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="c9" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="mlfq_policy_create(&amp;config)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;endSize=10;dashed=1;html=1;strokeColor=#666666;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="&lt;b style=&quot;&quot;&gt;OCP: extensiones verificables&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;Cambios de comportamiento SIN tocar el&lt;br/&gt;motor ni la politica:&lt;br/&gt;&lt;br/&gt;--policy mlfq | rr | fcfs&lt;br/&gt;     cambia la estrategia completa&lt;br/&gt;--quantums 2,4,8,16&lt;br/&gt;     agrega un cuarto nivel de cola&lt;br/&gt;--demote-to-lowest&lt;br/&gt;     otra regla de democion&lt;br/&gt;--queue srtf&lt;br/&gt;     otra disciplina interna de cola&lt;br/&gt;--boost 0&lt;br/&gt;     desactiva el priority boost&lt;br/&gt;&lt;br/&gt;Comprobacion de DIP:&lt;br/&gt;grep -rn &#x27;mlfq_policy_create&#x27; src/application/&lt;br/&gt;  -&gt; sin resultados&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="320" width="320" height="265" as="geometry"/></mxCell><mxCell id="t15" value="Protocolo por ciclo de reloj (lo ejecuta el motor; la politica solo decide)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="620" width="1200" height="24" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b style=&quot;&quot;&gt;1. admit(p, t)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;por cada proceso cuyo&lt;br/&gt;arrival_time == t&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="655" width="270" height="90" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b style=&quot;&quot;&gt;2. select_for_cycle(t)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;la politica devuelve quien&lt;br/&gt;ejecuta (o NULL = ociosa)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="360" y="655" width="270" height="90" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b style=&quot;&quot;&gt;3. el motor ejecuta 1 ciclo&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;process_consume_cycle()&lt;br/&gt;y publica los eventos&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="660" y="655" width="270" height="90" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b style=&quot;&quot;&gt;4. notify_cycle_result(...)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;la politica contabiliza&lt;br/&gt;el quantum consumido&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="960" y="655" width="270" height="90" as="geometry"/></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;html=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;html=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;html=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="&lt;b style=&quot;&quot;&gt;Reparto de responsabilidades&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;El motor detecta por si mismo que la politica eligio un proceso distinto al que tenia la CPU y solo entonces aplica las&lt;br/&gt;transiciones de estado (switch_context). La politica no necesita saber que existen los estados READY o RUNNING.&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="770" width="1120" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pagina-4" name="4. Patron Observer"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="Patron OBSERVER: el motor publica hechos y no conoce a ningun suscriptor" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=17;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="1200" height="30" as="geometry"/></mxCell><mxCell id="t2" value="Permite cuatro vistas distintas de la simulacion sin un solo printf dentro del planificador." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="56" width="1200" height="24" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b style=&quot;&quot;&gt;SimulationEngine&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:8px;color:#777;font-family:monospace&quot;&gt;src/application/simulation_engine.c&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;publica los eventos del CICLO DE VIDA:&lt;br/&gt;&lt;br/&gt;  SIMULACION_INICIADA&lt;br/&gt;  LLEGADA&lt;br/&gt;  DESPACHO&lt;br/&gt;  CICLO_EJECUTADO&lt;br/&gt;  EXPROPIACION&lt;br/&gt;  FIN_PROCESO&lt;br/&gt;  CPU_OCIOSA&lt;br/&gt;  SIMULACION_FINALIZADA&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="300" height="185" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b style=&quot;&quot;&gt;MlfqPolicy&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:8px;color:#777;font-family:monospace&quot;&gt;src/policies/mlfq_policy.c&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;publica los eventos de SU vocabulario:&lt;br/&gt;&lt;br/&gt;  QUANTUM_AGOTADO&lt;br/&gt;  DEMOCION&lt;br/&gt;  PRIORITY_BOOST&lt;br/&gt;&lt;br/&gt;Reparto deliberado: no hay eventos&lt;br/&gt;duplicados entre motor y politica.&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="350" width="300" height="150" as="geometry"/></mxCell><mxCell id="c5" value="&lt;i style=&quot;font-size:9px;color:#666&quot;&gt;&amp;#171;sujeto&amp;#187;&lt;/i&gt;&lt;br/&gt;&lt;b style=&quot;&quot;&gt;EventBus&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:8px;color:#777;font-family:monospace&quot;&gt;include/domain/event_bus.h  ·  src/domain/event_bus.c&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;- observers[16]&lt;br/&gt;+ event_bus_subscribe(observer)&lt;br/&gt;+ event_bus_publish(event)&lt;br/&gt;&lt;br/&gt;No conoce a los suscriptores.&lt;br/&gt;&lt;br/&gt;SimulationEvent (DTO inmutable):&lt;br/&gt;  type, cycle&lt;br/&gt;  const Process *process&lt;br/&gt;  from_queue, to_queue&lt;br/&gt;&lt;br/&gt;Al ser const, un observador NO puede&lt;br/&gt;alterar la simulacion.&lt;br/&gt;&lt;br/&gt;publish(NULL, ...) es valido y sin&lt;br/&gt;efecto (Null Object): el motor corre&lt;br/&gt;sin observadores en las pruebas.&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="190" width="300" height="265" as="geometry"/></mxCell><mxCell id="e6" value="publica" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;html=1;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="publica" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;html=1;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="&lt;b style=&quot;&quot;&gt;TraceObserver&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:8px;color:#777;font-family:monospace&quot;&gt;src/infrastructure/trace_observer.c&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;interface SimulationObserver -&gt; un solo metodo: on_event()&lt;br/&gt;imprime la traza ciclo a ciclo,&lt;br/&gt;con la ocupacion de cada cola&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="840" y="110" width="440" height="95" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b style=&quot;&quot;&gt;GanttObserver&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:8px;color:#777;font-family:monospace&quot;&gt;src/infrastructure/gantt_observer.c&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;interface SimulationObserver -&gt; un solo metodo: on_event()&lt;br/&gt;reconstruye la linea de tiempo:&lt;br/&gt;quien tuvo la CPU y en que nivel&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="840" y="230" width="440" height="95" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b style=&quot;&quot;&gt;StatsObserver&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:8px;color:#777;font-family:monospace&quot;&gt;src/infrastructure/stats_observer.c&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;interface SimulationObserver -&gt; un solo metodo: on_event()&lt;br/&gt;contadores agregados: despachos,&lt;br/&gt;demociones, boosts, expropiaciones&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="840" y="350" width="440" height="95" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b style=&quot;&quot;&gt;WaitGapObserver&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:8px;color:#777;font-family:monospace&quot;&gt;src/infrastructure/wait_gap_observer.c&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;interface SimulationObserver -&gt; un solo metodo: on_event()&lt;br/&gt;espera continua maxima por proceso:&lt;br/&gt;la metrica que revela la INANICION&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="840" y="470" width="440" height="95" as="geometry"/></mxCell><mxCell id="e12" value="on_event" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;html=1;strokeColor=#9673a6;strokeWidth=2;" edge="1" parent="1" source="c5" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="on_event" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;html=1;strokeColor=#9673a6;strokeWidth=2;" edge="1" parent="1" source="c5" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="on_event" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;html=1;strokeColor=#9673a6;strokeWidth=2;" edge="1" parent="1" source="c5" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="on_event" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;html=1;strokeColor=#9673a6;strokeWidth=2;" edge="1" parent="1" source="c5" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="&lt;b style=&quot;&quot;&gt;La justificacion mas fuerte del patron en este proyecto&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;WaitGapObserver se agrego DESPUES de tener el simulador terminado, porque las metricas obligatorias&lt;br/&gt;del enunciado no pueden medir la inanicion: con la CPU saturada, el proceso largo tiene el mismo&lt;br/&gt;turnaround con boost y sin boost (siempre es el ultimo en terminar).&lt;br/&gt;&lt;br/&gt;Se agrego SIN modificar el motor, ni la politica, ni las metricas del dominio: solo escucha eventos&lt;br/&gt;que ya existian. Eso es exactamente el beneficio que promete Observer, y aqui es comprobable.&lt;br/&gt;&lt;br/&gt;Interface Segregation: SimulationObserver tiene UN metodo, asi que ningun observador implementa&lt;br/&gt;operaciones que no necesita.&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="545" width="700" height="175" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b style=&quot;&quot;&gt;Quien se suscribe a que&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;La suscripcion ocurre en la raiz de composicion&lt;br/&gt;(src/cli/main.c -&gt; subscribe_observers), segun las&lt;br/&gt;banderas de linea de comandos:&lt;br/&gt;&lt;br/&gt;  siempre      StatsObserver, WaitGapObserver&lt;br/&gt;  por defecto  GanttObserver   (--no-gantt lo quita)&lt;br/&gt;  --trace      TraceObserver&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="840" y="590" width="440" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pagina-5" name="5. Factory Method, puertos y adaptadores"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="Factory Method + Puertos y Adaptadores: de donde salen los objetos" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=17;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="25" width="1200" height="30" as="geometry"/></mxCell><mxCell id="t2" value="Quien usa un objeto no lo construye. La capa mas externa decide las implementaciones y las inyecta (DIP)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="51" width="1200" height="24" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b style=&quot;&quot;&gt;src/cli/main.c  ·  COMPOSITION ROOT&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;build_process_source()   build_policy()   subscribe_observers()   build_writers()   composition_release()&lt;br/&gt;Unico archivo del proyecto que menciona implementaciones concretas. Tambien el unico responsable de liberarlas.&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="88" width="1240" height="78" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b style=&quot;&quot;&gt;RunSimulationUseCase&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:8px;color:#777;font-family:monospace&quot;&gt;src/application/run_simulation_use_case.c&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;cargar -&gt; simular -&gt; medir -&gt; publicar&lt;br/&gt;Depende solo de los dos puertos:&lt;br/&gt;no sabe que existen los archivos.&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="530" y="195" width="340" height="95" as="geometry"/></mxCell><mxCell id="c5" value="&lt;i style=&quot;font-size:9px;color:#666&quot;&gt;&amp;#171;puerto de entrada / factory&amp;#187;&lt;/i&gt;&lt;br/&gt;&lt;b style=&quot;&quot;&gt;ProcessSource&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:8px;color:#777;font-family:monospace&quot;&gt;include/application/ports/process_source.h&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;+ describe()&lt;br/&gt;+ load(table, error)   fabrica los Process&lt;br/&gt;+ destroy()&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="195" width="330" height="95" as="geometry"/></mxCell><mxCell id="c6" value="&lt;i style=&quot;font-size:9px;color:#666&quot;&gt;&amp;#171;puerto de salida&amp;#187;&lt;/i&gt;&lt;br/&gt;&lt;b style=&quot;&quot;&gt;ResultsWriter&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:8px;color:#777;font-family:monospace&quot;&gt;include/application/ports/results_writer.h&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;+ describe()&lt;br/&gt;+ write(report, error)&lt;br/&gt;+ destroy()&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="990" y="195" width="310" height="95" as="geometry"/></mxCell><mxCell id="e7" value="usa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;endSize=10;dashed=1;html=1;strokeColor=#666666;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="usa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;endSize=10;dashed=1;html=1;strokeColor=#666666;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="&lt;b style=&quot;&quot;&gt;CsvProcessSource&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:8px;color:#777;font-family:monospace&quot;&gt;src/infrastructure/csv_process_source.c&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;lee pid,arrival,burst; valida cada linea y&lt;br/&gt;traduce el error con su numero de linea&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="330" width="330" height="66" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b style=&quot;&quot;&gt;RandomProcessSource&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:8px;color:#777;font-family:monospace&quot;&gt;src/infrastructure/random_process_source.c&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;carga sintetica reproducible por semilla&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="408" width="330" height="66" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b style=&quot;&quot;&gt;BuiltinScenarioProcessSource&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:8px;color:#777;font-family:monospace&quot;&gt;src/infrastructure/builtin_scenario_process_source.c&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;el escenario P1..P4 del enunciado&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="486" width="330" height="66" as="geometry"/></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=0;endSize=12;dashed=1;html=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="c9" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=0;endSize=12;dashed=1;html=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="c10" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=0;endSize=12;dashed=1;html=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="c11" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="&lt;b style=&quot;&quot;&gt;CsvResultsWriter&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:8px;color:#777;font-family:monospace&quot;&gt;src/infrastructure/csv_results_writer.c&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;results.csv con las columnas del enunciado&lt;br/&gt;unico modulo que conoce ese formato&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="990" y="330" width="310" height="66" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b style=&quot;&quot;&gt;ConsoleResultsWriter&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:8px;color:#777;font-family:monospace&quot;&gt;src/infrastructure/console_results_writer.c&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;tabla legible + promedios en pantalla&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="990" y="408" width="310" height="66" as="geometry"/></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=0;endSize=12;dashed=1;html=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="c15" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=0;endSize=12;dashed=1;html=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="c16" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="&lt;b style=&quot;&quot;&gt;Por que son fabricas y no solo interfaces&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;Cada ProcessSource CONSTRUYE los Process a partir de una&lt;br/&gt;fuente distinta (archivo, generador, escenario fijo). El caso&lt;br/&gt;de uso recibe una ProcessTable ya poblada y validada.&lt;br/&gt;&lt;br/&gt;Agregar una fuente nueva (JSON, red, base de datos) o una&lt;br/&gt;salida nueva (JSON, SQLite) es un archivo nuevo y una linea&lt;br/&gt;en main.c: cero cambios en el nucleo.&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="470" y="330" width="460" height="145" as="geometry"/></mxCell><mxCell id="e20" value="crea e inyecta" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;html=1;strokeColor=#82b366;strokeWidth=2;exitX=0.1;exitY=1;" edge="1" parent="1" source="c3" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e21" value="crea e inyecta" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;html=1;strokeColor=#82b366;strokeWidth=2;exitX=0.9;exitY=1;" edge="1" parent="1" source="c3" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t22" value="El mismo mecanismo, un nivel mas abajo: la politica tampoco construye sus colas" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="520" width="1240" height="24" as="geometry"/></mxCell><mxCell id="c23" value="&lt;i style=&quot;font-size:9px;color:#666&quot;&gt;&amp;#171;interface&amp;#187;&lt;/i&gt;&lt;br/&gt;&lt;b style=&quot;&quot;&gt;ReadyQueue&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:8px;color:#777;font-family:monospace&quot;&gt;include/domain/ready_queue.h&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;+ enqueue(process, error)&lt;br/&gt;+ dequeue() : Process*&lt;br/&gt;+ peek()  + size()  + destroy()&lt;br/&gt;&lt;br/&gt;El planificador NUNCA depende de un&lt;br/&gt;arreglo circular concreto.&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="530" y="560" width="340" height="130" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b style=&quot;&quot;&gt;FifoReadyQueue&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:8px;color:#777;font-family:monospace&quot;&gt;src/domain/fifo_ready_queue.c&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;buffer circular que duplica su capacidad&lt;br/&gt;enqueue / dequeue O(1): son las dos&lt;br/&gt;operaciones de cada ciclo de reloj&lt;br/&gt;= disciplina Round Robin del nivel&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="740" width="250" height="110" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b style=&quot;&quot;&gt;ShortestRemainingReadyQueue&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:8px;color:#777;font-family:monospace&quot;&gt;shortest_remaining_ready_queue.c&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;arreglo ordenado por tiempo restante&lt;br/&gt;insercion estable&lt;br/&gt;existe para demostrar LSP/OCP:&lt;br/&gt;--queue srtf, sin tocar el planificador&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="680" y="740" width="260" height="110" as="geometry"/></mxCell><mxCell id="e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=0;endSize=12;dashed=1;html=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="c24" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=0;endSize=12;dashed=1;html=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="c25" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="&lt;b style=&quot;&quot;&gt;MlfqPolicy&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:8px;color:#777;font-family:monospace&quot;&gt;src/policies/mlfq_policy.c&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;recibe una ReadyQueueFactory:&lt;br/&gt;&lt;br/&gt;  factory = config-&gt;queue_factory&lt;br/&gt;          ? config-&gt;queue_factory&lt;br/&gt;          : fifo_ready_queue_create;&lt;br/&gt;  for (level ...) levels[l] = factory(l, err);&lt;br/&gt;&lt;br/&gt;Crea sus niveles sin conocer la clase.&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="560" width="330" height="130" as="geometry"/></mxCell><mxCell id="e29" value="usa la abstraccion" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;endSize=10;dashed=1;html=1;strokeColor=#666666;" edge="1" parent="1" source="c28" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="&lt;b style=&quot;&quot;&gt;ReadyQueueFactory&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;typedef ReadyQueue *(*ReadyQueueFactory)&lt;br/&gt;        (int level, Error *error);&lt;br/&gt;&lt;br/&gt;Factory Method reducido a su esencia:&lt;br/&gt;un puntero a funcion inyectable.&lt;br/&gt;&lt;br/&gt;Lo elige main.c segun --queue.&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="990" y="560" width="310" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pagina-6" name="6. Secuencia de un ciclo de reloj"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="Como colaboran los tres patrones en UN ciclo de reloj" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=17;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="25" width="1200" height="30" as="geometry"/></mxCell><mxCell id="t2" value="Motor (Strategy: pide la decision) · Process (State: aplica la transicion) · EventBus (Observer: difunde el hecho)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="51" width="1200" height="24" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b style=&quot;&quot;&gt;SimulationEngine&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;application/simulation_engine.c&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="95" width="200" height="58" as="geometry"/></mxCell><mxCell id="lv4" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="180.0" y="153" as="sourcePoint"/><mxPoint x="180.0" y="885" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c5" value="&lt;b style=&quot;&quot;&gt;SchedulingPolicy&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;policies/mlfq_policy.c&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="400" y="95" width="210" height="58" as="geometry"/></mxCell><mxCell id="lv6" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="505.0" y="153" as="sourcePoint"/><mxPoint x="505.0" y="885" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c7" value="&lt;b style=&quot;&quot;&gt;Process + ProcessState&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;domain/process_state.c&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="730" y="95" width="210" height="58" as="geometry"/></mxCell><mxCell id="lv8" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="835.0" y="153" as="sourcePoint"/><mxPoint x="835.0" y="885" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c9" value="&lt;b style=&quot;&quot;&gt;EventBus + observadores&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;domain/event_bus.c&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1060" y="95" width="240" height="58" as="geometry"/></mxCell><mxCell id="lv10" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1180.0" y="153" as="sourcePoint"/><mxPoint x="1180.0" y="885" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m11" value="1. process_admit(t)   [por cada arrival_time == t]" style="html=1;endArrow=blockThin;endFill=1;dashed=0;strokeColor=#333333;fontSize=9;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=left;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="180.0" y="195" as="sourcePoint"/><mxPoint x="835.0" y="195" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m12" value="2. admit(p, t)   la politica lo encola en Q0" style="html=1;endArrow=blockThin;endFill=1;dashed=0;strokeColor=#333333;fontSize=9;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=left;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="180.0" y="241" as="sourcePoint"/><mxPoint x="505.0" y="241" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m13" value="3. publica LLEGADA" style="html=1;endArrow=blockThin;endFill=1;dashed=0;strokeColor=#333333;fontSize=9;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=left;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="180.0" y="287" as="sourcePoint"/><mxPoint x="1180.0" y="287" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m14" value="4. select_for_cycle(t)" style="html=1;endArrow=blockThin;endFill=1;dashed=0;strokeColor=#333333;fontSize=9;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=left;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="180.0" y="333" as="sourcePoint"/><mxPoint x="505.0" y="333" as="targetPoint"/></mxGeometry></mxCell><mxCell id="am15" value="expira quantum -&gt; democion
aplica priority boost si t % S == 0
expropia si hay mayor prioridad" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#ffffff;align=left;verticalAlign=middle;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="505.0" y="359" as="sourcePoint"/><mxPoint x="505.0" y="415" as="targetPoint"/><Array as="points"><mxPoint x="655.0" y="359"/><mxPoint x="655.0" y="415"/></Array></mxGeometry></mxCell><mxCell id="m16" value="p  (o NULL = CPU ociosa)" style="html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#82b366;fontSize=9;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=right;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="505.0" y="441" as="sourcePoint"/><mxPoint x="180.0" y="441" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m17" value="5. process_dispatch(t)   [solo si cambio el ocupante de la CPU]" style="html=1;endArrow=blockThin;endFill=1;dashed=0;strokeColor=#333333;fontSize=9;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=left;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="180.0" y="491" as="sourcePoint"/><mxPoint x="835.0" y="491" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m18" value="6. publica DESPACHO   (cuenta un cambio de contexto)" style="html=1;endArrow=blockThin;endFill=1;dashed=0;strokeColor=#333333;fontSize=9;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=left;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="180.0" y="537" as="sourcePoint"/><mxPoint x="1180.0" y="537" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m19" value="7. process_consume_cycle()   remaining_time--" style="html=1;endArrow=blockThin;endFill=1;dashed=0;strokeColor=#333333;fontSize=9;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=left;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="180.0" y="583" as="sourcePoint"/><mxPoint x="835.0" y="583" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m20" value="8. publica CICLO_EJECUTADO" style="html=1;endArrow=blockThin;endFill=1;dashed=0;strokeColor=#333333;fontSize=9;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=left;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="180.0" y="629" as="sourcePoint"/><mxPoint x="1180.0" y="629" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m21" value="9. process_terminate(t + 1)   [si remaining_time == 0]" style="html=1;endArrow=blockThin;endFill=1;dashed=0;strokeColor=#333333;fontSize=9;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=left;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="180.0" y="675" as="sourcePoint"/><mxPoint x="835.0" y="675" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m22" value="10. publica FIN_PROCESO" style="html=1;endArrow=blockThin;endFill=1;dashed=0;strokeColor=#333333;fontSize=9;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=left;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="180.0" y="721" as="sourcePoint"/><mxPoint x="1180.0" y="721" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m23" value="11. notify_cycle_result(p, completed, t)" style="html=1;endArrow=blockThin;endFill=1;dashed=0;strokeColor=#333333;fontSize=9;labelBackgroundColor=#ffffff;verticalAlign=bottom;align=left;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="180.0" y="767" as="sourcePoint"/><mxPoint x="505.0" y="767" as="targetPoint"/></mxGeometry></mxCell><mxCell id="am24" value="consumed_quantum++
si completed: libera la CPU" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#333333;fontSize=9;labelBackgroundColor=#ffffff;align=left;verticalAlign=middle;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="505.0" y="793" as="sourcePoint"/><mxPoint x="505.0" y="833" as="targetPoint"/><Array as="points"><mxPoint x="655.0" y="793"/><mxPoint x="655.0" y="833"/></Array></mxGeometry></mxCell><mxCell id="c25" value="&lt;b style=&quot;&quot;&gt;Quien decide que&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;El MOTOR nunca pregunta por colas ni por quantums: solo pide un proceso y reporta el resultado.&lt;br/&gt;La POLITICA nunca toca el estado del proceso: no sabe que existen READY o RUNNING.&lt;br/&gt;Los OBSERVADORES solo reciben hechos ya ocurridos, con el Process en const: no pueden alterar nada.&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="770" width="600" height="105" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b style=&quot;&quot;&gt;Deteccion del cambio de contexto&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;El motor recuerda quien tenia la CPU. Si select_for_cycle devuelve otro proceso,&lt;br/&gt;expropia al anterior y despacha al nuevo (switch_context). Si devuelve el MISMO&lt;br/&gt;-por ejemplo tras una democion en la que sigue siendo el de mayor prioridad-&lt;br/&gt;no hay cambio de contexto y el proceso permanece en RUNNING.&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="730" y="770" width="570" height="105" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pagina-7" name="7. Algoritmo MLFQ"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="El algoritmo que implementa la politica: colas, democion y priority boost" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=17;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="25" width="1200" height="30" as="geometry"/></mxCell><mxCell id="t2" value="Es la regla de negocio del laboratorio; el resto del diseno existe para poder cambiarla y medirla." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="51" width="1200" height="24" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b style=&quot;&quot;&gt;Llegadas: todo proceso nuevo entra por Q0&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="250" y="88" width="430" height="46" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b style=&quot;&quot;&gt;Q0  ·  prioridad ALTA  ·  quantum 2&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;Round Robin (FIFO) dentro del nivel&lt;br/&gt;hipotesis optimista: se asume interactivo&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="250" y="160" width="430" height="72" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b style=&quot;&quot;&gt;Q1  ·  prioridad MEDIA  ·  quantum 4&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;turnos mas largos y menos frecuentes&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="250" y="285" width="430" height="72" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b style=&quot;&quot;&gt;Q2  ·  prioridad BAJA  ·  quantum 8&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;procesos intensivos en CPU (demostrado)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="250" y="410" width="430" height="72" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b style=&quot;&quot;&gt;CPU&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;1 proceso&lt;br/&gt;por ciclo de reloj&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=center;" vertex="1" parent="1"><mxGeometry x="770" y="250" width="150" height="90" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;html=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="se ejecuta SIEMPRE la cola de
mayor prioridad no vacia" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;html=1;strokeColor=#82b366;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;html=1;strokeColor=#82b366;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.75;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;html=1;strokeColor=#82b366;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=1;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="725" y="446"/><mxPoint x="725" y="340"/></Array></mxGeometry></mxCell><mxCell id="e12" value="DEMOCION" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;html=1;strokeColor=#333333;exitX=0.3;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="DEMOCION" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;html=1;strokeColor=#333333;exitX=0.3;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="PRIORITY BOOST cada S ciclos:
TODOS vuelven a Q0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;html=1;strokeColor=#b85450;strokeWidth=2;dashed=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c6" target="c4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="160" y="446"/><mxPoint x="160" y="196"/></Array></mxGeometry></mxCell><mxCell id="c15" value="&lt;b style=&quot;&quot;&gt;Las tres reglas que se suelen olvidar&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;1. NO hay democion si el proceso termina antes de agotar su quantum: se comporto como interactivo.&lt;br/&gt;2. El proceso EXPROPIADO por una llegada de mayor prioridad vuelve al final de SU MISMO nivel, sin&lt;br/&gt;   degradarse: no agoto su quantum, y castigarlo por la llegada de otro no es lo que MLFQ pretende.&lt;br/&gt;3. Un proceso ya en el ultimo nivel que agota su quantum no baja mas: se reencola en el mismo Q2.&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="530" width="620" height="110" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b style=&quot;&quot;&gt;El resultado, leido en la salida real del simulador&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;$ ./build/scheduler&lt;br/&gt;&lt;br/&gt;t      01234567890123456789012345      &amp;#9668;- ciclo de reloj&lt;br/&gt;P1     00......1111.........00...      &amp;#9668;- el digito es el NIVEL de cola&lt;br/&gt;P2     ..00........11............&lt;br/&gt;P3     ....00........1111.....001&lt;br/&gt;P4     ......00..........110.....&lt;br/&gt;                     &amp;#9650;&lt;br/&gt;     ciclo 20: priority boost -&gt; P3 y P4 vuelven a ejecutar en Q0&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="660" width="620" height="175" as="geometry"/></mxCell><mxCell id="t17" value="Orden de decisiones en select_for_cycle(t)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="980" y="88" width="390" height="24" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b style=&quot;&quot;&gt;1. ¿Quantum agotado?&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;consumed_quantum &gt;= quantum(nivel)&lt;br/&gt;-&gt; democion segun demotion_rule&lt;br/&gt;-&gt; reencola al final del destino&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="980" y="120" width="390" height="100" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b style=&quot;&quot;&gt;2. ¿t &gt; 0 y t % S == 0?&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;-&gt; PRIORITY BOOST: todos a Q0&lt;br/&gt;el proceso en CPU tambien se promueve&lt;br/&gt;y reinicia su quantum, pero no la pierde&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="980" y="238" width="390" height="100" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b style=&quot;&quot;&gt;3. ¿Alguien en cola superior?&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;-&gt; expropia al ocupante&lt;br/&gt;vuelve al final de SU MISMO nivel&lt;br/&gt;(no se degrada)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="980" y="356" width="390" height="100" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b style=&quot;&quot;&gt;4. ¿CPU libre?&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;-&gt; toma la cabeza de la cola de&lt;br/&gt;mayor prioridad no vacia&lt;br/&gt;si todas estan vacias: CPU ociosa&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="980" y="474" width="390" height="100" as="geometry"/></mxCell><mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;html=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;html=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="c19" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;html=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="&lt;b style=&quot;&quot;&gt;Por que ESE orden, y no otro&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;font-family:monospace;line-height:15px&quot;&gt;Si el boost (2) se evaluara ANTES de la expiracion del&lt;br/&gt;quantum (1), un proceso que acaba de agotar su turno&lt;br/&gt;seria promovido a Q0 y ADEMAS conservaria la CPU:&lt;br/&gt;premiaria exactamente al proceso intensivo en CPU que&lt;br/&gt;MLFQ quiere degradar.&lt;br/&gt;&lt;br/&gt;Cada una de estas cuatro decisiones tiene su propia&lt;br/&gt;prueba unitaria en tests/test_mlfq_policy.c, que&lt;br/&gt;reproduce el protocolo por ciclo SIN usar el motor:&lt;br/&gt;asi se puede afirmar en que nivel de cola esta un&lt;br/&gt;proceso en un ciclo exacto.&lt;br/&gt;&lt;br/&gt;Las cuatro son configurables desde la linea de&lt;br/&gt;comandos: --quantums, --boost, --no-preempt,&lt;br/&gt;--demote-to-lowest, --queue.&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;spacingRight=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="980" y="600" width="390" height="235" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
